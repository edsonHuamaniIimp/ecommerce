# ─── .env.prod.example — Variables de produccion para Docker ─────────────
# Copiar a .env.prod y configurar los valores reales.
#
# Uso: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_MOCK=0

# ─── Dominio ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL: la lee el codigo (links de correos, retorno Niubiz, reset password)
NEXT_PUBLIC_APP_URL=https://ecommerce.sistemasiimp.org.pe
APP_URL=https://ecommerce.sistemasiimp.org.pe

# ─── Base de datos (PostgreSQL incluido en el compose) ──────────────────
# El host es "postgres" porque es el nombre del servicio en docker-compose.
# DB_PASSWORD es usado por el contenedor PostgreSQL.
# Nota: la contrasena en DATABASE_URL debe coincidir con DB_PASSWORD.
DB_PASSWORD=
DATABASE_URL="postgresql://ctrst:<DB_PASSWORD>@postgres:5432/contratos_stands"

# ─── API externa KBEventos — Plano GESS ─────────────────────────────────
# production: https://secure2.iimp.org:8443/KBEventos/rest/planogess
# qa:         https://secure2.iimp.org:8443/KBEventosPruebas/rest/planogess
PLANOGESS_API_URL="https://secure2.iimp.org:8443/KBEventos/rest/planogess"
KBSERVICIOS_URL="https://secure2.iimp.org:8443/KBServiciosIIMPJavaEnvironment"

# ─── JWT para autenticacion de roles ────────────────────────────────────
JWT_SECRET=

# ─── Almacenamiento de archivos ─────────────────────────────────────────
# STORAGE_PROVIDER=s3  → archivos van directo a S3
# STORAGE_PROVIDER=local → guarda en public/uploads/ (solo desarrollo)
STORAGE_PROVIDER=s3

S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=

# ─── Migraciones automaticas (opcional) ──────────────────────────────────
RUN_MIGRATIONS=false

# ─── Integracion SGC (Sistema de Gestion de Contratos) ──────────────────
# Activa la integracion (1 = activa, 0 = desactivada).
# El disparo ocurre al aprobar la revision Comunicacion (Legal se delega al SGC).
SGC_ENABLED=0
# Modo del cliente: mock (sin red) | real
SGC_MODE=mock
# URL base de la API de integracion del SGC
SGC_API_URL=
# Clave Bearer del actor de servicio (rol contract-manager)
SGC_API_KEY=
# Catalogos definidos por el SGC para el tipo de expediente
SGC_AREA_CODE=
SGC_CONTRACT_TYPE_CODE=
# Secreto HMAC de la suscripcion de webhooks (solo cuando aplique)
SGC_WEBHOOK_SECRET=
# Timeout de las llamadas al SGC (ms)
SGC_TIMEOUT_MS=10000

