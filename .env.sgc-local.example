# ================================================================
# ContratosStands — Integración SGC en LOCAL (modo mock)
# Pegar estas variables en tu .env (o .env.local) y reiniciar `npm run dev`.
# En modo mock no se llama al SGC real: el adaptador es en memoria.
# ================================================================

# Activa la integración
SGC_ENABLED=1
# mock = adaptador en memoria (sin red) | real = adaptador HTTP
SGC_MODE=mock
# Catálogos (en mock cualquier valor sirve; el SGC real los define)
SGC_AREA_CODE=EVENTOS
SGC_CONTRACT_TYPE_CODE=AUSPICIO
# Secreto HMAC para firmar/validar los webhooks simulados
SGC_WEBHOOK_SECRET=local-webhook-secret
# Secreto del cron de reconciliación (header x-cron-secret)
CRON_SECRET=local-cron-secret
# Timeout de las llamadas al SGC (ms)
SGC_TIMEOUT_MS=10000

# Para usar el SGC REAL desde local (lo permite: auth por clave, sin IP):
# SGC_MODE=real
# SGC_API_URL=https://gestion-contratos.sistemasiimp.org.pe/api/integrations/v1
# SGC_API_KEY=sgc_<clave-del-actor-contract-manager>
