# ================================================================
# ContratosStands — Variables de Entorno
# ================================================================
# Copiar este archivo a .env y ajustar los valores según el ambiente.
#
# Ambientes soportados:
#   local      → desarrollo en máquina del dev (Docker PostgreSQL)
#   qa         → pruebas / homologación
#   production → producción
#
# NEXT_PUBLIC_APP_ENV define el ambiente y se expone al cliente.
# ================================================================

# Ambiente (local | qa | production)
NEXT_PUBLIC_APP_ENV=local

# API mock (1 = datos fake sin backend, 0 = API real)
NEXT_PUBLIC_API_MOCK=1

# URL base del backend (solo si NEXT_PUBLIC_API_MOCK=0)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# PostgreSQL (Prisma)
# local:      postgresql://ctrst:ctrst_dev@localhost:5432/contratos_stands
# qa:         postgresql://<usuario>:<password>@<host-qa>:5432/contratos_stands_qa
# production: postgresql://<usuario>:<password>@<host-prod>:5432/contratos_stands
DATABASE_URL="postgresql://ctrst:ctrst_dev@localhost:5432/contratos_stands"

# API externa KBEventos — Plano GESS
# local/qa:  https://secure2.iimp.org:8443/KBEventosPruebas/rest/planogess
# production: https://secure2.iimp.org:8443/KBEventos/rest/planogess
PLANOGESS_API_URL="https://secure2.iimp.org:8443/KBEventosPruebas/rest/planogess"

# JWT para autenticacion de roles (cambiar en produccion)
JWT_SECRET="dev-secret-cambiar-en-produccion"

# Almacenamiento de archivos
# local:  guarda en public/uploads/
# s3:     guarda en bucket S3 (requiere S3_BUCKET, S3_REGION, S3_ENDPOINT)
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
