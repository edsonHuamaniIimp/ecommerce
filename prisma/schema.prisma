generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * ================================================================
 * 1. MAESTRAS — catálogos que rara vez cambian
 * ================================================================
 */

model EventoPadre {
  id       String   @id @default(uuid())
  codigo   String   @unique @db.VarChar(20)
  vertical String   @db.VarChar(20)
  nombre   String   @db.VarChar(100)
  eventos  Evento[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("evento_padre")
}

model Evento {
  id            String    @id @default(uuid())
  eventoPadreId String    @map("evento_padre_id")
  tipoEvento    Int       @map("tipo_evento")
  codigoEvento  Int       @map("codigo_evento")
  anio          String    @db.VarChar(4)
  estado        String    @default("active") @db.VarChar(20)
  planoRef      String?   @map("plano_ref") @db.VarChar(255)
  fechaInicio   DateTime? @map("fecha_inicio")
  fechaFin      DateTime? @map("fecha_fin")
  imagen        String?   @db.VarChar(500)
  flgActivo     Boolean   @default(true) @map("flg_activo")
  flgVisible    Boolean   @default(true) @map("flg_visible")
  plano         String    @default("gess") @db.VarChar(50)
  eventoPadre        EventoPadre         @relation(fields: [eventoPadreId], references: [id])
  tiposStand         TipoStand[]
  stands             Stand[]
  gessStands         GessStand[]
  reservas           Reserva[]
  plantillas         ContratoPlantilla[]
  debidasDiligencias DebidaDiligencia[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tipoEvento, codigoEvento])
  @@index([eventoPadreId])
  @@index([estado])
  @@map("evento")
}

model EventoMetadata {
  tipoEvento   Int     @map("tipo_evento")
  codigoEvento Int     @map("codigo_evento")
  plano        String? @db.VarChar(50)
  flgVisible   Boolean @default(false) @map("flg_visible")
  imagen       String? @db.VarChar(500)
  /// Modal informativo mostrado en /mapa (config por version). Ver ModalInfoConfig.
  modalInfo    Json?   @map("modal_info")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tipoEvento, codigoEvento])
  @@map("evento_metadata")
}

model TipoStand {
  id        String  @id @default(uuid())
  eventoId  String  @map("evento_id")
  nombre    String  @db.VarChar(50)
  medidas   String? @db.VarChar(50)
  montoBase Float   @map("monto_base")
  moneda    String  @default("USD") @db.VarChar(3)

  evento     Evento              @relation(fields: [eventoId], references: [id])
  stands     Stand[]
  plantillas ContratoPlantilla[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventoId])
  @@map("tipo_stand")
}

model ContratoPlantilla {
  id          String  @id @default(uuid())
  tipoStandId String  @map("tipo_stand_id")
  eventoId    String? @map("evento_id")
  nombre      String  @db.VarChar(100)
  url         String? @db.VarChar(500)

  tipoStand TipoStand @relation(fields: [tipoStandId], references: [id])
  evento    Evento?   @relation(fields: [eventoId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contrato_plantilla")
}

model Role {
  id          String   @id @default(uuid())
  nombre      String   @unique @db.VarChar(50)
  descripcion String?  @db.VarChar(200)
  permisos    String[] @default([])
  /// Secciones/modulos habilitados para configurar permisos del rol.
  modulos     String[] @default([])

  usuarios UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("role")
}

model UserRole {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id") @db.VarChar(100)
  roleId              String    @map("role_id")
  email               String    @db.VarChar(200)
  password            String    @default("123456") @db.VarChar(100)
  nombre              String?   @db.VarChar(200)
  apellidos           String?   @db.VarChar(200)
  telefono            String?   @db.VarChar(20)
  tipoUsuarioId       Int?      @map("tipo_usuario_id")
  idEmpresa           String?   @map("id_empresa") @db.VarChar(50)
  nombreEmpresa       String?   @map("nombre_empresa") @db.VarChar(200)
  /// Logo propio del usuario (URL en /uploads/*); tiene prioridad sobre el de la empresa en el mapa.
  logoUrl             String?   @map("logo_url") @db.VarChar(500)
  /// Firma digital del usuario (imagen PNG/JPG en /uploads/*) para firmar contratos desde el portal.
  firmaUrl            String?   @map("firma_url") @db.VarChar(500)
  /**
   * Ultimo evento seleccionado: se reusa al iniciar sesion para no pedirlo de nuevo.
   */
  eventoId            String?   @map("evento_id") @db.VarChar(50)
  /**
   * Nombre visible del ultimo evento elegido (lo envia la presala); se reusa al iniciar sesion.
   */
  eventoNombre        String?   @map("evento_nombre") @db.VarChar(200)
  eventoPadreNombre   String?   @map("evento_padre_nombre") @db.VarChar(200)
  resetToken          String?   @map("reset_token") @db.VarChar(200)
  resetTokenExpires   DateTime? @map("reset_token_expires")
  /// Empresa del Portal del Cliente a la que pertenece la cuenta (registrada por backoffice).
  empresaId           String?   @map("empresa_id")
  /// Credencial temporal: el usuario debe cambiar la contrasena en el primer ingreso.
  debeCambiarPassword Boolean   @default(false) @map("debe_cambiar_password")
  /// Acceso habilitado: false bloquea el login y corta la sesion activa (cuenta deshabilitada).
  flgActivo           Boolean   @default(true) @map("flg_activo")
  /// Reactivacion programada (desactivacion masiva): a esta fecha/hora la cuenta vuelve a estar activa; null = sin programar.
  reactivarEn         DateTime? @map("reactivar_en")
  /// Idioma preferido del usuario: es | en (ver IDIOMAS). Default espanol.
  idioma              String    @default("es") @db.VarChar(5)
  /// Identificador de la persona en servicio-persona (sie_code, ej. P0000012345). La persona vive en la fuente.
  sieCode             String?   @map("sie_code") @db.VarChar(20)
  /// Documento de la empresa vinculada (RUC o RUT, copiado de la ficha) para representar la cuenta.
  ruc                 String?   @db.VarChar(20)
  /// Correo elegido por el usuario para recibir notificaciones (puede diferir del correo de acceso).
  notificationEmail   String?   @map("notification_email") @db.VarChar(200)
  /// Fecha de verificacion del correo de notificaciones.
  notificationEmailVerifiedAt DateTime? @map("notification_email_verified_at")
  /// Correo pendiente de verificacion; no se usa hasta confirmar el codigo.
  notificationEmailPending String? @map("notification_email_pending") @db.VarChar(200)
  /// Codigo temporal de verificacion del correo de notificaciones.
  notificationEmailCode String? @map("notification_email_code") @db.VarChar(10)
  /// Vencimiento del codigo de verificacion del correo de notificaciones.
  notificationEmailCodeExpires DateTime? @map("notification_email_code_expires")
  /// Valor legado `user|<correo>` conservado para rollback de la migracion de identidad.
  initialUserId       String?   @map("initial_user_id") @db.VarChar(100)

  role    Role     @relation(fields: [roleId], references: [id])
  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([initialUserId])
  @@index([notificationEmail])
  @@index([email])
  @@index([empresaId])
  @@index([sieCode])
  @@index([flgActivo, reactivarEn])
  @@map("user_role")
}

/// Solicitud de cuenta de nuevo exhibidor enviada desde el portal publico.
/// Nace en estado pendiente y la resuelve un administrador (aprobar/rechazar).
model SolicitudCuenta {
  id String @id @default(uuid())

  /// Correo electronico corporativo del solicitante.
  email         String    @db.VarChar(200)
  /// Nombres del contacto.
  nombre        String    @db.VarChar(200)
  /// Apellidos del contacto.
  apellidos     String    @db.VarChar(200)
  /// Telefono de contacto.
  telefono      String?   @db.VarChar(20)
  /// Razon social de la empresa exhibidora.
  razonSocial   String    @map("razon_social") @db.VarChar(200)
  /// RUC de la empresa (11 digitos).
  ruc           String?   @db.VarChar(11)
  /// Cargo del contacto dentro de la empresa.
  cargo         String?   @db.VarChar(100)
  /// Mensaje adicional del solicitante.
  mensaje       String?   @db.Text
  /// Estado de la solicitud (ver ESTADOS_SOLICITUD_CUENTA).
  estado        String    @default("pendiente") @db.VarChar(20)
  /// Motivo obligatorio cuando la solicitud es rechazada.
  motivoRechazo String?   @map("motivo_rechazo") @db.Text
  /// Email del administrador que reviso la solicitud.
  revisadoPor   String?   @map("revisado_por") @db.VarChar(200)
  /// Fecha de la revision.
  revisadoEn    DateTime? @map("revisado_en")
  /// userId del usuario creado al aprobar la solicitud.
  usuarioId     String?   @map("usuario_id") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([estado])
  @@map("solicitud_cuenta")
}

/// Registro de exhibidor pendiente de verificacion por codigo enviado al correo.
/// La contrasena se guarda ya hasheada; el codigo expira y limita intentos.
model RegistroPendiente {
  id String @id @default(uuid())

  /// Correo electronico a verificar (unico).
  email       String   @unique @db.VarChar(200)
  /// Codigo numerico enviado por correo.
  codigo      String   @db.VarChar(10)
  /// Contrasena ya hasheada (se transfiere al usuario al confirmar).
  password    String   @db.VarChar(100)
  /// Nombres del contacto.
  nombre      String   @db.VarChar(200)
  /// Apellidos del contacto.
  apellidos   String   @db.VarChar(200)
  /// Razon social de la empresa exhibidora.
  razonSocial String   @map("razon_social") @db.VarChar(200)
  /// Telefono de contacto.
  telefono    String?  @db.VarChar(20)
  /// RUC de la empresa (11 digitos).
  ruc         String?  @db.VarChar(11)
  /// Intentos de verificacion fallidos.
  intentos    Int      @default(0)
  /// Fecha/hora de expiracion del codigo.
  expiraEn    DateTime @map("expira_en")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("registro_pendiente")
}

/**
 * ================================================================
 * 2. TRANSACCIONALES — datos que cambian con frecuencia
 * ================================================================
 */

/// Empresa exhibidora registrada por el backoffice (cuenta del Portal del Cliente).
/// Los datos marcados como contractuales alimentan el contrato de alquiler.
model Empresa {
  id                       String    @id @default(uuid())
  /// Documento de la empresa: RUC (11 digitos) o RUT/no domiciliado (alfanumerico, hasta 20). Unico.
  ruc                      String    @unique @db.VarChar(20)
  /// Tipo de documento de empresa (ver TIPOS_DOCUMENTO_EMPRESA: "6" = RUC, "0" = no domiciliado/RUT).
  tipoDocumento            String    @default("6") @map("tipo_documento") @db.VarChar(10)
  /// Identificador de la empresa en servicio-persona (sie_code, ej. E0000000123). La empresa vive en la fuente.
  sieCode                  String?   @map("sie_code") @db.VarChar(20)
  /// Pais de la empresa (ISO 3166-1 alpha-2; por defecto PE).
  pais                     String    @default("PE") @map("pais") @db.VarChar(2)
  /// Razon social; usada en el cuerpo del contrato.
  razonSocial              String    @map("razon_social") @db.VarChar(200)
  /// Logo de la empresa (URL en /uploads/*); se pinta en sus stands reservados del mapa.
  logoUrl                  String?   @map("logo_url") @db.VarChar(500)
  /// Nombre comercial (opcional, no contractual).
  nombreComercial          String?   @map("nombre_comercial") @db.VarChar(200)
  /// Direccion fiscal; usada en el contrato.
  direccionFiscal          String?   @map("direccion_fiscal") @db.VarChar(250)
  /// Telefono de contacto de la empresa.
  telefono                 String?   @db.VarChar(30)
  /// Correo de contacto general.
  emailContacto            String?   @map("email_contacto") @db.VarChar(200)
  /// Correo para facturacion y comprobantes (Tributos).
  emailFacturacion         String?   @map("email_facturacion") @db.VarChar(200)
  /// Representante legal (nombre completo); firma el contrato.
  representanteLegalNombre String?   @map("representante_legal_nombre") @db.VarChar(200)
  /// Tipo de documento del representante (TIPOS_DOCUMENTO_PERSONA; default 1 = DNI).
  representanteLegalTipoDocumento String @default("1") @map("representante_legal_tipo_documento") @db.VarChar(10)
  /// Numero de documento del representante legal.
  representanteLegalDni    String?   @map("representante_legal_dni") @db.VarChar(15)
  /// Correo del representante legal (crea su cuenta del Portal y sincroniza con la fuente).
  representanteCorreo      String?   @map("representante_correo") @db.VarChar(200)
  /// Celular del representante legal.
  representanteCelular     String?   @map("representante_celular") @db.VarChar(35)
  /// Direccion del representante legal.
  representanteDireccion   String?   @map("representante_direccion") @db.VarChar(100)
  /// Nombre que se imprime en el friso del stand.
  nombreFriso              String?   @map("nombre_friso") @db.VarChar(200)
  /// Actividad economica declarada/consultada en SUNAT.
  actividadEconomica       String?   @map("actividad_economica") @db.VarChar(200)
  /// Estado y condicion del contribuyente en SUNAT (ej. ACTIVO / HABIDO).
  estadoContribuyente      String?   @map("estado_contribuyente") @db.VarChar(80)
  /// Nombre que debe figurar en la factura (si difiere de la razon social).
  facturarANombre          String?   @map("facturar_a_nombre") @db.VarChar(200)
  /// Responsable de coordinacion EXTEMIN.
  responsableExteminNombre String?   @map("responsable_extemin_nombre") @db.VarChar(200)
  responsableExteminTelefono String? @map("responsable_extemin_telefono") @db.VarChar(35)
  responsableExteminTipoDocumento String @default("1") @map("responsable_extemin_tipo_documento") @db.VarChar(10)
  responsableExteminDni    String?   @map("responsable_extemin_dni") @db.VarChar(15)
  responsableExteminEmail  String?   @map("responsable_extemin_email") @db.VarChar(200)
  /// Responsable del area de pagos.
  responsablePagosNombre   String?   @map("responsable_pagos_nombre") @db.VarChar(200)
  responsablePagosTelefono String?   @map("responsable_pagos_telefono") @db.VarChar(35)
  responsablePagosTipoDocumento String @default("1") @map("responsable_pagos_tipo_documento") @db.VarChar(10)
  responsablePagosDni      String?   @map("responsable_pagos_dni") @db.VarChar(15)
  responsablePagosEmail    String?   @map("responsable_pagos_email") @db.VarChar(200)
  /// Codigo SIE de la persona del representante en servicio-persona (null = aun solo local, pendiente de sincronizar).
  representanteSieCode     String?   @map("representante_sie_code") @db.VarChar(20)
  /// Cuenta del representante legal vinculada a la empresa (user_role.user_id).
  representanteUserId      String?   @map("representante_user_id") @db.VarChar(100)
  /// Partida electronica de inscripcion de poderes del representante legal (si aplica).
  partidaElectronica       String?   @map("partida_electronica") @db.VarChar(50)
  /// Configuracion personalizada de cuotas definida por el administrador:
  /// { maxCuotas: 1..3, fechas: ["yyyy-mm-dd", ...] }. null = cronograma estandar.
  configCuotas             Json?     @map("config_cuotas")
  /// Tipo de comprobante preferido: factura | boleta (ver TIPOS_COMPROBANTE).
  tipoComprobante          String    @default("factura") @map("tipo_comprobante") @db.VarChar(20)
  /// Sitio web (opcional).
  sitioWeb                 String?   @map("sitio_web") @db.VarChar(200)
  /// Estado de la empresa: activa | inactiva (ver ESTADOS_EMPRESA).
  estado                   String    @default("activa") @db.VarChar(20)
  /// La cuenta del Portal del Cliente ya fue creada/enviada.
  cuentaCreada             Boolean   @default(false) @map("cuenta_creada")
  /// El primer acceso (validacion de datos) fue completado.
  primerAccesoCompletado   Boolean   @default(false) @map("primer_acceso_completado")
  /// Registro de datos validados por la empresa (primer login).
  datosValidadosEn         DateTime? @map("datos_validados_en")
  /// Usuario (correo) que dio de alta la empresa en el backoffice.
  creadoPor                String?   @map("creado_por") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios           UserRole[]
  debidasDiligencias DebidaDiligencia[]

  @@index([razonSocial])
  @@index([sieCode])
  @@index([estado])
  @@index([representanteUserId])
  @@map("empresa")
}

model Stand {
  id           String  @id @default(uuid())
  eventoId     String  @map("evento_id")
  tipoStandId  String  @map("tipo_stand_id")
  numero       String  @db.VarChar(20)
  monto        Float
  moneda       String  @default("USD") @db.VarChar(3)
  estado       String  @default("disponible") @db.VarChar(20)
  tipoCamara   String? @map("tipo_camara") @db.VarChar(20)
  numeroCamara String? @map("numero_camara") @db.VarChar(20)

  evento    Evento         @relation(fields: [eventoId], references: [id])
  tipoStand TipoStand      @relation(fields: [tipoStandId], references: [id])
  posicion  PlanoPosicion?
  reservas  ReservaStand[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventoId, estado])
  @@map("stand")
}

model PlanoPosicion {
  id      String @id @default(uuid())
  standId String @unique @map("stand_id")
  x       Float
  y       Float

  stand Stand @relation(fields: [standId], references: [id])

  @@map("plano_posicion")
}

model GessStand {
  id                    String    @id @default(uuid())
  eventoId              String    @map("evento_id")
  standApiId            String    @map("stand_api_id") @db.VarChar(50)
  standCode             String    @map("stand_code") @db.VarChar(50)
  tipoStand             String?   @map("tipo_stand") @db.VarChar(100)
  medidas               String?   @db.VarChar(100)
  estado                String?   @db.VarChar(50)
  empresa               String?   @db.VarChar(200)
  pabellon              String?   @db.VarChar(50)
  ubicacion             String?   @db.VarChar(100)
  rawData               Json?     @map("raw_data")
  bloqueId              String?   @map("bloque_id") @db.VarChar(50)
  email                 String?   @db.VarChar(200)
  userId                String?   @map("user_id") @db.VarChar(100)
  /// Valor legado `user|<correo>` conservado para rollback de la migracion de identidad.
  initialUserId         String?   @map("initial_user_id") @db.VarChar(100)
  /// Bloqueo temporal mientras el cliente completa el wizard (no es una reserva).
  holdId                String?   @map("hold_id") @db.VarChar(64)
  holdUserId            String?   @map("hold_user_id") @db.VarChar(100)
  holdExpiresAt         DateTime? @map("hold_expires_at")
  documentos            Json?     @default("[]")
  imagenes              Json?     @default("[]")
  /// Categoria por imagen: { "<url>": "<categoria>" } (ver CATEGORIAS_IMAGEN).
  imagenesCategorias    Json?     @default("{}") @map("imagenes_categorias")
  /// Categoria por documento: { "<url>": "<categoria>" } (ver CATEGORIAS_DOCUMENTO).
  documentosCategorias  Json?     @default("{}") @map("documentos_categorias")
  /// Empresa montajista asignada (SIE code, ej. E0000105823).
  montajistaId          String?   @map("montajista_id") @db.VarChar(20)
  montajistaNombre      String?   @map("montajista_nombre") @db.VarChar(200)
  montajistaAsignadaEn  DateTime? @map("montajista_asignada_en")
  montajistaAsignadaPor String?   @map("montajista_asignada_por") @db.VarChar(200)

  /// Pre-reserva (bloqueo con empresa, sin solicitud ni contrato).
  preReservaRazonSocial String?   @map("pre_reserva_razon_social") @db.VarChar(200)
  /// Pre-reserva por titulo (texto libre) cuando no hay empresa.
  preReservaTitulo      String?   @map("pre_reserva_titulo") @db.VarChar(200)
  preReservaRuc         String?   @map("pre_reserva_ruc") @db.VarChar(11)
  preReservaSie         String?   @map("pre_reserva_sie") @db.VarChar(20)
  preReservaLogoUrl     String?   @map("pre_reserva_logo_url") @db.VarChar(500)
  preReservaNota        String?   @map("pre_reserva_nota") @db.VarChar(300)
  preReservaPor         String?   @map("pre_reserva_por") @db.VarChar(200)
  preReservaAt          DateTime? @map("pre_reserva_at")

  evento              Evento                     @relation(fields: [eventoId], references: [id])
  solicitudes         Solicitud[]
  solicitudStands     SolicitudStand[]           @relation("SolicitudStandGess")
  montajistaHistorial StandMontajistaHistorial[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([eventoId, standApiId])
  @@unique([eventoId, standCode])
  @@unique([eventoId, bloqueId])
  @@index([eventoId])
  @@index([bloqueId])
  @@index([initialUserId])
  @@index([holdId])
  @@index([holdExpiresAt])
  @@map("gess_stand")
}

/// Imagen referencial por tipo de stand: una imagen por tipo, aplicada a todos los
/// stands de ese tipo (se administra en la bandeja de Stands y se muestra en el mapa).
model TipoStandImagen {
  id        String   @id @default(uuid())
  /// Clave canonica del tipo de stand (ver TIPOS_STAND_CATALOGO).
  tipo      String   @db.VarChar(50)
  /// Evento al que aplica la imagen (null = imagen global de respaldo).
  eventoId  String?  @map("evento_id") @db.VarChar(100)
  /// URL de la imagen referencial (en /uploads/*).
  imagenUrl String   @map("imagen_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventoId, tipo])
  @@map("tipo_stand_imagen")
}

/**
 * ================================================================
 * 2.5 SOLICITUDES — ciclo de reserva
 * ================================================================
 */

model Solicitud {
  id                  String    @id @default(uuid())
  gessStandId         String?   @map("gess_stand_id")
  userId              String?   @map("user_id") @db.VarChar(100)
  /// Valor legado `user|<correo>` conservado para rollback de la migracion de identidad.
  initialUserId       String?   @map("initial_user_id") @db.VarChar(100)
  email               String?   @db.VarChar(200)
  documentos          Json?     @default("[]")
  /// RF-08: URL de la imagen (PNG) del recorte del pabellon con el stand destacado; se adjunta al contrato.
  recortePlanoUrl     String?   @map("recorte_plano_url") @db.VarChar(500)
  /// RF-10/11: snapshot del plan de cuotas configurado al reservar { modalidad, cuotas[] }.
  planCuotas          Json?     @map("plan_cuotas")
  /// Datos comerciales/fiscales capturados en el paso 1 del wizard (payload del IIMP).
  datosFacturacion    Json?     @map("datos_facturacion")
  /// Reserva oficial en el API del IIMP: contrato (10 digitos), cuenta corriente y cliente.
  iimpContrato        String?   @map("iimp_contrato") @db.VarChar(20)
  iimpCuentaCorriente String?   @map("iimp_cuenta_corriente") @db.VarChar(20)
  iimpClienteCodigo   String?   @map("iimp_cliente_codigo") @db.VarChar(20)
  /// Respuesta completa del API de reserva (auditoria y conciliacion).
  iimpReserva         Json?     @map("iimp_reserva")
  iimpReservaAt       DateTime? @map("iimp_reserva_at")
  flgActivo           Boolean   @default(true) @map("flg_activo")
  estado              String?   @db.VarChar(20)
  /// Habilitador del revisor: muestra al cliente la firma del contrato posterior.
  contratoHabilitado  Boolean   @default(false) @map("contrato_habilitado")
  /// Auditoria de la ultima creacion/actualizacion de la solicitud.
  createdBy           String?   @map("created_by") @db.VarChar(200)
  updatedBy           String?   @map("updated_by") @db.VarChar(200)
  createdIp           String?   @map("created_ip") @db.VarChar(45)
  updatedIp           String?   @map("updated_ip") @db.VarChar(45)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  gessStand      GessStand?           @relation(fields: [gessStandId], references: [id])
  revisiones     Revision[]
  reevaluaciones Reevaluacion[]
  docsAdjuntos   SolicitudDocumento[] @relation("SolicitudDocs")
  stands         SolicitudStand[]
  facturaciones  Facturacion[]
  sgcExpediente  SgcExpediente?

  @@index([gessStandId])
  @@index([initialUserId])
  @@map("solicitud")
}

/**
 * ================================================================
 * 3. RESERVAS — ciclo completo de reserva
 * ================================================================
 */

model Reserva {
  id               String @id @default(uuid())
  eventoId         String @map("evento_id")
  empresaRef       String @map("empresa_ref") @db.VarChar(100)
  tipoComprobante  String @map("tipo_comprobante") @db.VarChar(20)
  datosFacturacion Json   @map("datos_facturacion")
  responsablePago  Json?  @map("responsable_pago")
  estado           String @default("registrada") @db.VarChar(20)

  evento       Evento              @relation(fields: [eventoId], references: [id])
  stands       ReservaStand[]
  cuotas       Cuota[]
  aprobaciones Aprobacion[]
  interop      InteropFacturacion?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([eventoId])
  @@index([estado])
  @@index([empresaRef])
  @@map("reserva")
}

model ReservaStand {
  id        String @id @default(uuid())
  reservaId String @map("reserva_id")
  standId   String @map("stand_id")
  tipoStand String @map("tipo_stand") @db.VarChar(50)
  monto     Float
  moneda    String @default("USD") @db.VarChar(3)

  reserva Reserva @relation(fields: [reservaId], references: [id])
  stand   Stand   @relation(fields: [standId], references: [id])

  @@index([reservaId])
  @@index([standId])
  @@map("reserva_stand")
}

model Cuota {
  id         String    @id @default(uuid())
  reservaId  String    @map("reserva_id")
  numero     Int
  porcentaje Float
  monto      Float
  fechaPago  DateTime? @map("fecha_pago")

  reserva Reserva @relation(fields: [reservaId], references: [id])

  @@index([reservaId])
  @@map("cuota")
}

model Aprobacion {
  id          String    @id @default(uuid())
  reservaId   String    @map("reserva_id")
  area        String    @db.VarChar(20)
  estado      String    @default("pendiente") @db.VarChar(20)
  responsable String?   @db.VarChar(100)
  comentario  String?
  fecha       DateTime?

  reserva Reserva @relation(fields: [reservaId], references: [id])

  @@index([reservaId])
  @@map("aprobacion")
}

model Revision {
  id          String   @id @default(uuid())
  solicitudId String   @map("solicitud_id")
  area        String   @db.VarChar(20)
  estado      String   @default("pendiente") @db.VarChar(20)
  comentario  String?
  createdBy   String?  @map("created_by") @db.VarChar(100)
  updatedBy   String?  @map("updated_by") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])

  @@unique([solicitudId, area])
  @@map("revision")
}

model RevisionHistorial {
  id                 String   @id @default(uuid())
  solicitudId        String   @map("solicitud_id")
  area               String   @db.VarChar(20)
  estadoAnterior     String   @map("estado_anterior") @db.VarChar(20)
  comentarioAnterior String?  @map("comentario_anterior")
  motivo             String   @db.VarChar(500)
  createdBy          String?  @map("created_by") @db.VarChar(100)
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([solicitudId])
  @@index([solicitudId, area])
  @@index([createdAt])
  @@map("revision_historial")
}

model Reevaluacion {
  id          String   @id @default(uuid())
  solicitudId String   @map("solicitud_id")
  estado      String   @default("pendiente") @db.VarChar(20)
  motivo      String?  @db.VarChar(1000)
  documentos  Json?    @default("[]")
  createdBy   String?  @map("created_by") @db.VarChar(100)
  updatedBy   String?  @map("updated_by") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])

  @@index([solicitudId])
  @@index([estado])
  @@map("reevaluacion")
}

model InteropFacturacion {
  id          String  @id @default(uuid())
  reservaId   String  @unique @map("reserva_id")
  ordenVenta  String? @map("orden_venta") @db.VarChar(50)
  comprobante String? @db.VarChar(50)
  estado      String  @default("enviado") @db.VarChar(20)
  requestRef  Json?   @map("request_ref")
  responseRef Json?   @map("response_ref")

  reserva Reserva @relation(fields: [reservaId], references: [id])

  @@map("interop_facturacion")
}

/**
 * ================================================================
 * 4. AUDITORÍA
 * ================================================================
 */

model AuditLog {
  id        String   @id @default(uuid())
  tipo      String   @db.VarChar(30)
  entidad   String?  @db.VarChar(100)
  actor     String?  @db.VarChar(100)
  mensaje   String
  metadata  Json?
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  metodo    String?  @db.VarChar(10)
  ruta      String?  @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tipo])
  @@index([entidad])
  @@index([createdAt])
  @@map("audit_log")
}

model ErrorLog {
  id        String   @id @default(uuid())
  message   String
  stack     String?
  digest    String?
  url       String?
  userId    String?  @map("user_id") @db.VarChar(100)
  /// Valor legado `user|<correo>` conservado para rollback de la migracion de identidad.
  initialUserId String? @map("initial_user_id") @db.VarChar(100)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("error_log")
}

model Facturacion {
  id          String   @id @default(uuid())
  solicitudId String   @map("solicitud_id")
  tipo        String   @default("manual") @db.VarChar(20) // "niubizz" | "manual"
  estado      String   @default("pendiente") @db.VarChar(20) // pendiente, pagado, cancelado
  montoTotal  Decimal  @map("monto_total") @db.Decimal(12, 2)
  moneda      String   @default("US$") @db.VarChar(5)
  modoPago    String   @default("cuotas") @map("modo_pago") @db.VarChar(10) // "completo" | "cuotas"
  createdBy   String?  @map("created_by") @db.VarChar(100)
  flgActivo   Boolean  @default(true) @map("flg_activo")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  solicitud Solicitud          @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  cuotas    FacturacionCuota[]

  @@index([solicitudId])
  @@index([estado])
  @@map("facturacion")
}

model FacturacionCuota {
  id                      String    @id @default(uuid())
  facturacionId           String    @map("facturacion_id")
  numero                  Int
  monto                   Decimal   @db.Decimal(12, 2)
  fechaVencimiento        DateTime? @map("fecha_vencimiento")
  estado                  String    @default("pendiente") @db.VarChar(20) // pendiente, pagado, vencido
  /// Voucher de pago subido por el cliente (pendiente de confirmacion).
  comprobante             String?   @db.VarChar(500)
  /// Comprobante fiscal (boleta/factura) que adjunta Facturacion a la cuota pagada: URL del archivo.
  comprobanteFiscal       String?   @map("comprobante_fiscal") @db.VarChar(500)
  /// Tipo del comprobante fiscal: "boleta" | "factura" (ver TIPOS_COMPROBANTE).
  comprobanteFiscalTipo   String?   @map("comprobante_fiscal_tipo") @db.VarChar(10)
  /// Numero del comprobante fiscal (serie-numero).
  comprobanteFiscalNumero String?   @map("comprobante_fiscal_numero") @db.VarChar(30)
  /// Fecha/hora en que Facturacion adjunto el comprobante fiscal.
  comprobanteFiscalAt     DateTime? @map("comprobante_fiscal_at")
  /// Usuario que adjunto el comprobante fiscal.
  comprobanteFiscalBy     String?   @map("comprobante_fiscal_by") @db.VarChar(100)
  /// Documento fiscal emitido por el IIMP para esta cuota (serie, numero, fecha, IGV, total).
  iimpDocumento           Json?     @map("iimp_documento")
  iimpEmitidaAt           DateTime? @map("iimp_emitida_at")
  /// Justificacion del sistema de facturacion al anular o rechazar (estado 2); se limpia al reemitir.
  iimpJustificacion       String?   @map("iimp_justificacion") @db.VarChar(500)
  createdAt               DateTime  @default(now()) @map("created_at")

  facturacion Facturacion @relation(fields: [facturacionId], references: [id], onDelete: Cascade)

  @@index([facturacionId])
  @@map("facturacion_cuota")
}

model FacturacionHistorial {
  id            String   @id @default(uuid())
  facturacionId String   @map("facturacion_id")
  accion        String   @db.VarChar(20) // "actualizar", "eliminar", "agregar_cuota", "pagar_cuota"
  detalle       String   @db.VarChar(500)
  metadata      Json?
  createdBy     String?  @map("created_by") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([facturacionId])
  @@index([createdAt])
  @@map("facturacion_historial")
}

model Alerta {
  id          String   @id @default(uuid())
  userId      String   @map("user_id") @db.VarChar(100)
  /// Valor legado `user|<correo>` conservado para rollback de la migracion de identidad.
  initialUserId String? @map("initial_user_id") @db.VarChar(100)
  tipo        String   @db.VarChar(30)
  titulo      String   @db.VarChar(200)
  mensaje     String   @db.VarChar(1000)
  /// Clave de plantilla (`ALERTA_CLAVES`) para renderizar titulo/mensaje en el idioma del destinatario.
  clave       String?  @db.VarChar(60)
  /// Datos de interpolacion de la plantilla de alerta.
  datos       Json?
  leida       Boolean  @default(false)
  url         String?  @db.VarChar(500)
  solicitudId String?  @map("solicitud_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([initialUserId])
  @@index([userId, leida])
  @@index([createdAt])
  @@map("alerta")
}

model SolicitudDocumento {
  id          String   @id @default(uuid())
  solicitudId String   @map("solicitud_id")
  url         String   @db.VarChar(500)
  nombre      String   @db.VarChar(200)
  uploadedBy  String?  @map("uploaded_by") @db.VarChar(100)
  userId      String?  @map("user_id") @db.VarChar(100)
  /// Valor legado `user|<correo>` conservado para rollback de la migracion de identidad.
  initialUserId String? @map("initial_user_id") @db.VarChar(100)
  categoria   String?  @db.VarChar(30)
  /// Requisito del anexo que cubre el documento (clave de ANEXOS_REQUERIDOS); null = otro anexo.
  requisito   String?  @db.VarChar(30)
  /// Origen del documento (`generado` = plantilla del sistema | `personalizado` | null = legacy/subida simple).
  origen      String?  @db.VarChar(20)
  /// SHA-256 del archivo firmado: impide reutilizar el mismo firmado en otra solicitud.
  sha256      String?  @db.VarChar(64)
  /// Estado logico del documento (ver ESTADOS_DOCUMENTO_SOLICITUD): activo | observado | reemplazado | baja.
  estado      String   @default("activo") @db.VarChar(20)
  /// Justificacion de la observacion del revisor (estado = observado).
  motivoObservacion String? @map("motivo_observacion") @db.VarChar(1000)
  /// Revisor que observo el documento (email).
  observadoPor String? @map("observado_por") @db.VarChar(200)
  observadoAt DateTime? @map("observado_at")
  flgActivo   Boolean  @default(true) @map("flg_activo")
  createdAt   DateTime @default(now()) @map("created_at")

  solicitud Solicitud @relation(fields: [solicitudId], references: [id], name: "SolicitudDocs")

  @@index([solicitudId])
  @@index([initialUserId])
  @@index([sha256])
  @@index([solicitudId, estado])
  @@map("solicitud_documento")
}

model SolicitudStand {
  id          String @id @default(uuid())
  solicitudId String @map("solicitud_id")
  gessStandId String @map("gess_stand_id")

  solicitud Solicitud @relation(fields: [solicitudId], references: [id])
  gessStand GessStand @relation(fields: [gessStandId], references: [id], name: "SolicitudStandGess")

  @@unique([solicitudId, gessStandId])
  @@index([solicitudId])
  @@index([gessStandId])
  @@map("solicitud_stand")
}

/**
 * ================================================================
 * 5. MAESTRA — diccionario jerarquico de valores lookup
 * ================================================================
 */

model Maestra {
  id              Int     @id @default(autoincrement())
  nidMaestraPadre Int     @default(0) @map("nid_maestra_padre")
  tabla           String  @db.VarChar(100)
  itemId          Int?    @map("item_id")
  numOrden        Int     @default(0) @map("num_orden")
  nombre          String  @db.VarChar(250)
  descripcion     String? @db.VarChar(500)
  activo          Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tabla])
  @@index([nidMaestraPadre])
  @@map("maestra")
}

/**
 * ================================================================
 * 6. PLANOS 3D — Laboratorio 3D: mapas editables almacenados en BD
 * plano.codigo es lo que guarda evento_metadata.plano
 * ================================================================
 */

model Plano {
  id          String  @id @default(uuid())
  codigo      String  @unique @db.VarChar(50) // "gess", "perumin"
  nombre      String  @db.VarChar(100)
  descripcion String? @db.VarChar(300)
  tipo        String  @default("simple") @db.VarChar(10) // "simple" | "macro"
  imagenFondo String? @map("imagen_fondo") @db.VarChar(500) // mapa de pabellones (macro)
  config      Json? // { floor, camera, legend } opcional
  flgActivo   Boolean @default(true) @map("flg_activo")

  tipos     PlanoTipoBloque[]
  bloques   PlanoBloque[]
  furniture PlanoFurniture[]
  secciones PlanoSeccion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("plano")
}

model PlanoSeccion {
  id          String  @id @default(uuid())
  planoId     String  @map("plano_id")
  codigo      String  @db.VarChar(50) // "PAB-A"
  nombre      String  @db.VarChar(100) // "Pabellon A"
  x           Float   @db.Real // coords normalizadas 0-1 sobre la imagen
  y           Float   @db.Real
  w           Float   @db.Real
  h           Float   @db.Real
  rotacion    Float   @default(0) @map("rotacion") @db.Real // grados (0-360), rotacion del rect sobre la imagen
  puntos      Json? // seccion libre: N puntos normalizados [{x,y}]; null = rectangulo
  color       String  @default("#3b82f6") @db.VarChar(10)
  planoHijoId String? @map("plano_hijo_id") // FK logica → plano 3D del pabellon
  orden       Int     @default(0)

  plano Plano @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@unique([planoId, codigo])
  @@index([planoId])
  @@map("plano_seccion")
}

model PlanoTipoBloque {
  id        String  @id @default(uuid())
  planoId   String  @map("plano_id")
  codigo    String  @db.VarChar(20) // "S", "BG", "P", "C"
  label     String  @db.VarChar(20)
  nombre    String  @db.VarChar(50) // "Columna", "Preferencial"
  w         Float   @db.Real
  d         Float   @db.Real
  h         Float   @db.Real
  color     String  @db.VarChar(10) // "#FFD700"
  ambito    String  @default("interno") @db.VarChar(10) // "interno" | "externo"
  forma     String  @default("bloque") @db.VarChar(20) // "bloque" | "tractor-orugas" | "cargador-frontal"
  flgActivo Boolean @default(true) @map("flg_activo")

  plano   Plano         @relation(fields: [planoId], references: [id], onDelete: Cascade)
  bloques PlanoBloque[]

  @@unique([planoId, codigo])
  @@map("plano_tipo_bloque")
}

model TipoBloqueGlobal {
  id        String   @id @default(uuid())
  codigo    String   @unique @db.VarChar(20)
  label     String   @db.VarChar(20)
  nombre    String   @db.VarChar(50)
  w         Float    @db.Real
  d         Float    @db.Real
  h         Float    @db.Real
  color     String   @db.VarChar(10)
  ambito    String   @default("interno") @db.VarChar(10)
  forma     String   @default("bloque") @db.VarChar(20)
  flgActivo Boolean  @default(true) @map("flg_activo")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tipo_bloque_global")
}

model PlanoBloque {
  id         String  @id @default(uuid())
  planoId    String  @map("plano_id")
  tipoId     String? @map("tipo_id")
  bloqueId   String  @db.VarChar(50) // "EXT-IZQ-01" — join key a gess_stand.bloque_id
  tipoCodigo String  @db.VarChar(20) // redundante para queries rapidas
  tipologia  String? @map("tipologia") @db.VarChar(1) // "1"=Complejo, "2"=Simple, "3"=Octanorm (maestra stand_tipologia)
  x          Float   @db.Real
  z          Float   @db.Real
  rotY       Float   @default(0) @map("rot_y") @db.Real
  orden      Int     @default(0)
  flgActivo  Boolean @default(true) @map("flg_activo")

  plano Plano            @relation(fields: [planoId], references: [id], onDelete: Cascade)
  tipo  PlanoTipoBloque? @relation(fields: [tipoId], references: [id], onDelete: SetNull)

  @@unique([planoId, bloqueId])
  /// Codigo de bloque unico en toda la BD: la vinculacion (gess_stand.bloque_id)
  /// une por codigo y es unica por evento; dos planos con el mismo codigo se bloquean.
  @@unique([bloqueId])
  @@index([planoId])
  @@map("plano_bloque")
}

model PlanoFurniture {
  id        String  @id @default(uuid())
  planoId   String  @map("plano_id")
  refId     String  @map("ref_id") @db.VarChar(50) // "KIOSKO_IZQ"
  tipo      String  @db.VarChar(30) // "kiosko" (extensible)
  x         Float   @db.Real
  z         Float   @db.Real
  rotY      Float   @default(0) @map("rot_y") @db.Real
  config    Json?
  flgActivo Boolean @default(true) @map("flg_activo")

  plano Plano @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@unique([planoId, refId])
  @@index([planoId])
  @@map("plano_furniture")
}

/**
 * ================================================================
 * 7. INTEGRACIÓN SGC — correlación con el Sistema de Gestión de Contratos
 * Contrato: APIS_USE_HOOKS.md / docs/05-integraciones/integracion-sgc.md
 * ================================================================
 */

model SgcExpediente {
  id                       String    @id @default(uuid())
  solicitudId              String    @unique @map("solicitud_id")
  code                     String    @unique @db.VarChar(50)
  contractId               String?   @unique @map("contract_id") @db.VarChar(64)
  estadoEnvio              String    @default("pendiente") @map("estado_envio") @db.VarChar(20)
  stage                    String?   @db.VarChar(40)
  lifecycleStatus          String?   @map("lifecycle_status") @db.VarChar(20)
  version                  Int?
  areaCode                 String    @map("area_code") @db.VarChar(40)
  contractTypeCode         String    @map("contract_type_code") @db.VarChar(40)
  /// Motivo (libre) de la corrección declarado por el admin cuando el SGC devuelve el
  /// trámite. Puede repetirse N veces (una por cada devolución); se limpia al reenviar.
  subsanacionMotivo        String?   @map("subsanacion_motivo") @db.VarChar(500)
  /// Modo de la subsanación vigente: `nuevo_contrato` | `mismo_contrato` (null = libre/legacy).
  subsanacionModo          String?   @map("subsanacion_modo") @db.VarChar(20)
  lastSyncedAt             DateTime? @map("last_synced_at")
  lastError                String?   @map("last_error") @db.VarChar(500)
  /// Bypass admin: el contrato se marco aprobado localmente; no lo sobreescribe el sync-on-read.
  bypassAprobado           Boolean   @default(false) @map("bypass_aprobado")
  /// Ultima devolucion del SGC (`workflow.returned`, guia §8): `true` = exige version nueva
  /// del principal (vuelve a elaboracion y el cliente puede subsanar); `false` = validacion
  /// interna sobre la misma version (no se pide correccion al cliente).
  devolucionRequiereCambio Boolean?  @map("devolucion_requiere_cambio")
  /// Motivo (libre) de la ultima devolucion, tal como llega en `data.reason` del webhook.
  devolucionMotivo         String?   @map("devolucion_motivo") @db.VarChar(500)
  /// Etapa destino de la devolucion (`null` = origen).
  devolucionDestinoStepId  String?   @map("devolucion_destino_step_id") @db.VarChar(64)
  /// Estrategia de la devolucion: `return-to-sender` | `restart-forward`.
  devolucionEstrategia     String?   @map("devolucion_estrategia") @db.VarChar(30)

  solicitud     Solicitud        @relation(fields: [solicitudId], references: [id])
  documentos    SgcDocumento[]
  subsanaciones SgcSubsanacion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([estadoEnvio])
  @@index([stage])
  @@map("sgc_expediente")
}

/// Bitácora auditable de cada ronda de subsanación (rechazo → motivo → corrección → reenvío).
model SgcSubsanacion {
  id              String    @id @default(uuid())
  sgcExpedienteId String    @map("sgc_expediente_id")
  /// Número de ronda de subsanación (1, 2, 3…).
  ronda           Int
  /// Motivo/indicación que declaró el administrador para esta ronda.
  motivo          String    @db.VarChar(500)
  /// Modo declarado: `nuevo_contrato` | `mismo_contrato` (null = libre/legacy).
  modo            String?   @db.VarChar(20)
  /// declarado | reenviado
  estado          String    @default("declarado") @db.VarChar(20)
  declaradoPor    String    @map("declarado_por") @db.VarChar(200)
  declaradoAt     DateTime  @default(now()) @map("declarado_at")
  reenviadoPor    String?   @map("reenviado_por") @db.VarChar(200)
  reenviadoAt     DateTime? @map("reenviado_at")
  /// Pieza documental del contrato en el SGC tras la corrección (trazabilidad).
  documentId      String?   @map("document_id") @db.VarChar(64)
  versionId       String?   @map("version_id") @db.VarChar(64)

  sgcExpediente SgcExpediente @relation(fields: [sgcExpedienteId], references: [id])

  @@index([sgcExpedienteId])
  @@map("sgc_subsanacion")
}

model SgcDocumento {
  id               String  @id @default(uuid())
  sgcExpedienteId  String  @map("sgc_expediente_id")
  documentId       String  @unique @map("document_id") @db.VarChar(64)
  currentVersionId String? @map("current_version_id") @db.VarChar(64)
  category         String  @db.VarChar(20)
  title            String  @db.VarChar(200)
  fileName         String  @map("file_name") @db.VarChar(255)
  checksumSha256   String? @map("checksum_sha256") @db.VarChar(64)
  sizeBytes        Int?    @map("size_bytes")
  estado           String  @default("reservado") @db.VarChar(20)

  sgcExpediente SgcExpediente @relation(fields: [sgcExpedienteId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sgcExpedienteId])
  @@map("sgc_documento")
}

model SgcWebhookEvento {
  id           String    @id @default(uuid())
  eventId      String    @unique @map("event_id") @db.VarChar(64)
  eventType    String    @map("event_type") @db.VarChar(40)
  resourceId   String?   @map("resource_id") @db.VarChar(64)
  resourceCode String?   @map("resource_code") @db.VarChar(50)
  /// Id de entrega del webhook (`x-sgc-delivery`): dedup por entrega, ademas de `eventId`.
  deliveryId   String?   @unique @map("delivery_id") @db.VarChar(80)
  payload      Json
  procesadoAt  DateTime? @map("procesado_at")
  error        String?   @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventType])
  @@index([resourceId])
  @@map("sgc_webhook_evento")
}

/// Cola de salida (outbox): operaciones hacia el SGC con reintentos y backoff.
model SgcOutbox {
  id             String   @id @default(uuid())
  operacion      String   @db.VarChar(40) // subir-contrato | subir-anexos | subsanar
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(160)
  payload        Json
  estado         String   @default("pendiente") @db.VarChar(20) // pendiente|enviado|error
  intentos       Int      @default(0)
  ultimoError    String?  @map("ultimo_error") @db.VarChar(500)
  programadoAt   DateTime @default(now()) @map("programado_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([estado, programadoAt])
  @@map("sgc_outbox")
}

/// Auditoria de asignacion/reemplazo de la empresa montajista por stand.
model StandMontajistaHistorial {
  id               String   @id @default(uuid())
  gessStandId      String   @map("gess_stand_id")
  /// SIE de la montajista (null = desasignacion).
  montajistaId     String?  @map("montajista_id") @db.VarChar(20)
  montajistaNombre String?  @map("montajista_nombre") @db.VarChar(200)
  /// asignar | reemplazar | desasignar
  accion           String   @db.VarChar(20)
  createdBy        String?  @map("created_by") @db.VarChar(200)
  createdAt        DateTime @default(now()) @map("created_at")

  gessStand GessStand @relation(fields: [gessStandId], references: [id], onDelete: Cascade)

  @@index([gessStandId])
  @@map("stand_montajista_historial")
}

/// Configuracion publica del portal (registro unico): enlaces y contactos que usan
/// el login y la presala. Administrable desde /dashboard/configuracion.
model PortalConfig {
  id             String   @id @default("default") @db.VarChar(20)
  /// Correo de la Mesa de Ayuda (se pinta como mailto en el portal).
  mesaAyudaEmail String?  @map("mesa_ayuda_email") @db.VarChar(200)
  /// Correo de contacto general.
  contactoEmail  String?  @map("contacto_email") @db.VarChar(200)
  /// URL del Manual del Exhibidor.
  manualUrl      String?  @map("manual_url") @db.VarChar(500)
  /// URL del Reglamento de Stands.
  reglamentoUrl  String?  @map("reglamento_url") @db.VarChar(500)
  /// Minutos que un stand queda bloqueado mientras el cliente completa el wizard.
  holdReservaMinutos Int  @default(25) @map("hold_reserva_minutos")
  /// Aviso global de mantenimiento para los usuarios del portal.
  mantenimientoActivo Boolean @default(false) @map("mantenimiento_activo")
  mantenimientoInicio DateTime? @map("mantenimiento_inicio")
  mantenimientoFin    DateTime? @map("mantenimiento_fin")
  /// true = el usuario puede cerrar el aviso; false = bloqueo hasta el fin.
  mantenimientoPermiteCerrar Boolean @default(false) @map("mantenimiento_permite_cerrar")
  updatedBy      String?  @map("updated_by") @db.VarChar(200)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("portal_config")
}

/**
 * ================================================================
 * 7. DEBIDA DILIGENCIA (DD)
 * Modulo con reglas propias: formulario de 4 pasos, revision de
 * Logistica, revision reputacional de Comunicaciones y vigencia de
 * 6 meses. Las tablas llevan el prefijo `debida_diligencia_` para
 * distinguirlas del resto de modulos del sistema.
 * ================================================================
 */

/// Expediente de debida diligencia de una empresa en un evento.
/// Lote de importacion de resultados de DD (Excel/CSV/TXT).
model DdImportacion {
  id          String   @id @default(uuid())
  archivo     String   @db.VarChar(255)
  hash        String   @db.VarChar(64)
  eventoId    String   @map("evento_id")
  usuario     String   @db.VarChar(200)
  total       Int
  importados  Int      @default(0)
  actualizados Int     @default(0)
  omitidos    Int      @default(0)
  errores     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  expedientes DebidaDiligencia[]

  @@index([eventoId])
  @@index([createdAt])
  @@map("dd_importacion")
}

model DebidaDiligencia {
  id        String @id @default(uuid())
  empresaId String @map("empresa_id")
  eventoId  String @map("evento_id")
  /// Codigo visible del expediente (ej. DD-2026-0142).
  codigo    String @unique @db.VarChar(30)
  /// Estado del workflow (ver DD_ESTADOS): borrador | pendiente | en_revision | observada | aprobada | rechazada.
  estado    String @default("borrador") @db.VarChar(20)
  /// Origen del registro: flujo_regular | importado.
  origen    String @default("flujo_regular") @db.VarChar(20)
  /// Resultado original de la fuente externa (APTO, EN REVISION, etc.).
  estadoOrigen String? @map("estado_origen") @db.VarChar(80)
  /// Proyecto/evento tal como viene en el archivo de importacion.
  eventoProyecto String? @map("evento_proyecto") @db.VarChar(120)
  /// Motivo/vinculo original de la fuente externa.
  motivoImportacion String? @map("motivo_importacion") @db.VarChar(250)
  /// Lote que origino el registro importado.
  importacionId String? @map("importacion_id")

  /// Tipo de relacion comercial con el IIMP (ver DD_VINCULOS).
  tipoRelacionComercial  String? @map("tipo_relacion_comercial") @db.VarChar(40)
  /// Actividad economica principal (catalogo DD_ACTIVIDADES_ECONOMICAS).
  actividadEconomica     String? @map("actividad_economica") @db.VarChar(120)
  /// Detalle cuando la actividad economica es "Otro".
  actividadEconomicaOtro String? @map("actividad_economica_otro") @db.VarChar(200)
  /// Pais de constitucion de la empresa (por defecto Peru).
  paisConstitucion       String? @map("pais_constitucion") @db.VarChar(80)
  sitioWeb               String? @map("sitio_web") @db.VarChar(200)
  emailRepresentante     String? @map("email_representante") @db.VarChar(200)

  /// Consentimiento de tratamiento de datos personales y derechos ARCO.
  aceptaDatos        Boolean @default(false) @map("acepta_datos")
  /// Consentimiento de debida diligencia reforzada.
  aceptaVerificacion Boolean @default(false) @map("acepta_verificacion")
  /// Declaracion jurada de veracidad y compromiso de actualizacion.
  declaraVerdad      Boolean @default(false) @map("declara_verdad")

  representanteNombre        String? @map("representante_nombre") @db.VarChar(200)
  representanteTipoDocumento String? @map("representante_tipo_documento") @db.VarChar(30)
  representanteDocumento     String? @map("representante_documento") @db.VarChar(20)
  representanteNacionalidad  String? @map("representante_nacionalidad") @db.VarChar(80)

  fechaEnvio       DateTime? @map("fecha_envio")
  fechaRevision    DateTime? @map("fecha_revision")
  fechaAprobacion  DateTime? @map("fecha_aprobacion")
  fechaVencimiento DateTime? @map("fecha_vencimiento")
  fechaRechazo     DateTime? @map("fecha_rechazo")
  revisadoPor      String?   @map("revisado_por") @db.VarChar(200)
  motivoRechazo    String?   @map("motivo_rechazo") @db.VarChar(1000)

  fechaDerivacionLegal DateTime? @map("fecha_derivacion_legal")
  derivadoLegalPor     String?   @map("derivado_legal_por") @db.VarChar(200)
  /// Link del informe de Logistica enviado a Legal (por ejemplo, Google Drive).
  informeLogisticaUrl  String?   @map("informe_logistica_url") @db.VarChar(500)
  fechaLegal           DateTime? @map("fecha_legal")
  legalRevisor         String?   @map("legal_revisor") @db.VarChar(200)
  decisionLegal        String?   @map("decision_legal") @db.VarChar(20)
  motivoLegal          String?   @map("motivo_legal") @db.VarChar(2000)
  informeLegalNombre   String?   @map("informe_legal_nombre") @db.VarChar(250)
  informeLegalUrl      String?   @map("informe_legal_url") @db.VarChar(500)

  creadoPor        String    @map("creado_por") @db.VarChar(200)
  actualizadoPor   String?   @map("actualizado_por") @db.VarChar(200)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  empresa       Empresa                        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  evento        Evento                         @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  importacion   DdImportacion?                 @relation(fields: [importacionId], references: [id], onDelete: SetNull)
  beneficiarios DebidaDiligenciaBeneficiario[]
  documentos    DebidaDiligenciaDocumento[]
  observaciones DebidaDiligenciaObservacion[]
  historial     DebidaDiligenciaHistorial[]
  reputacion    DebidaDiligenciaReputacion[]
  matrizVinculos DdMatrizVinculo[]

  @@unique([empresaId, eventoId])
  @@index([eventoId, estado])
  @@index([fechaVencimiento])
  @@index([codigo])
  @@index([origen])
  @@index([importacionId])
  @@map("debida_diligencia")
}

/// Beneficiario final con 10% o mas de participacion.
model DebidaDiligenciaBeneficiario {
  id           String  @id @default(uuid())
  expedienteId String  @map("expediente_id")
  orden        Int     @default(0)
  nombre       String  @db.VarChar(200)
  documento    String  @db.VarChar(30)
  nacionalidad String  @db.VarChar(80)
  porcentaje   Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expediente DebidaDiligencia @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@index([expedienteId])
  @@map("debida_diligencia_beneficiario")
}

/// Documento de sustento del expediente (4 obligatorios).
model DebidaDiligenciaDocumento {
  id           String  @id @default(uuid())
  expedienteId String  @map("expediente_id")
  /// Tipo de documento (ver DD_DOCUMENTOS).
  tipo         String  @db.VarChar(40)
  nombre       String  @db.VarChar(250)
  url          String  @db.VarChar(500)
  /// Estado del documento (ver DD_DOCUMENTO_ESTADOS).
  estado       String  @default("cargado") @db.VarChar(20)
  observacion  String? @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expediente DebidaDiligencia @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  versiones  DebidaDiligenciaDocumentoVersion[]

  @@unique([expedienteId, tipo])
  @@index([expedienteId])
  @@map("debida_diligencia_documento")
}

/// Historial de archivos cargados para un documento de debida diligencia.
model DebidaDiligenciaDocumentoVersion {
  id          String   @id @default(uuid())
  documentoId String   @map("documento_id")
  version     Int
  nombre      String   @db.VarChar(250)
  url         String   @db.VarChar(500)
  creadoPor   String?  @map("creado_por") @db.VarChar(200)
  createdAt   DateTime @default(now()) @map("created_at")

  documento DebidaDiligenciaDocumento @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@unique([documentoId, version])
  @@index([documentoId])
  @@map("debida_diligencia_documento_version")
}

/// Observacion emitida por Logistica/Legal/Comunicaciones sobre el expediente.
model DebidaDiligenciaObservacion {
  id              String    @id @default(uuid())
  expedienteId    String    @map("expediente_id")
  /// Area que emite la observacion (ver DD_OBSERVACION_AREAS).
  area            String    @db.VarChar(30)
  /// Tipo de documento observado (null = observacion general).
  documentoTipo   String?   @map("documento_tipo") @db.VarChar(40)
  texto           String    @db.VarChar(1000)
  /// abierta | resuelta
  estado          String    @default("abierta") @db.VarChar(20)
  creadoPor       String    @map("creado_por") @db.VarChar(200)
  fechaResolucion DateTime? @map("fecha_resolucion")

  createdAt DateTime @default(now()) @map("created_at")

  expediente DebidaDiligencia @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@index([expedienteId, estado])
  @@map("debida_diligencia_observacion")
}

/// Evento del flujo de debida diligencia para el historial visible del expediente.
/// Las observaciones se leen de DebidaDiligenciaObservacion; esta tabla guarda
/// envios, subsanaciones, derivaciones y decisiones de Logistica/Legal.
model DebidaDiligenciaHistorial {
  id           String  @id @default(uuid())
  expedienteId String  @map("expediente_id")
  /// Tipo de evento (ver DD_HISTORIAL_TIPOS).
  tipo         String  @db.VarChar(40)
  /// Area que origina el evento (ver DD_OBSERVACION_AREAS).
  area         String? @db.VarChar(30)
  /// Estado resultante del expediente.
  estado       String? @db.VarChar(20)
  titulo       String  @db.VarChar(200)
  detalle      String? @db.VarChar(1500)
  actor        String  @db.VarChar(200)
  /// Datos auxiliares del evento (documentos, conteos, links, etc.).
  metadata     Json?

  createdAt DateTime @default(now()) @map("created_at")

  expediente DebidaDiligencia @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@index([expedienteId, createdAt])
  @@map("debida_diligencia_historial")
}

/// Caso de revision reputacional derivado por Logistica a Comunicaciones.
model DebidaDiligenciaReputacion {
  id              String    @id @default(uuid())
  expedienteId    String    @map("expediente_id")
  /// Nombre o razon social a evaluar (empresa, representante o beneficiario).
  nombreARevisar  String    @map("nombre_a_revisar") @db.VarChar(200)
  sitioWeb        String?   @map("sitio_web") @db.VarChar(200)
  /// Estado del caso (ver DD_REPUTACION_ESTADOS).
  estado          String    @default("por_revisar") @db.VarChar(30)
  /// Resultado de la revision (ver DD_REPUTACION_RESULTADOS); null mientras no se resuelve.
  resultado       String?   @db.VarChar(30)
  comentario      String?   @db.VarChar(1500)
  /// Link de sustento cuando el resultado es con hallazgos.
  linkHallazgos   String?   @map("link_hallazgos") @db.VarChar(500)
  derivadoPor     String    @map("derivado_por") @db.VarChar(200)
  fechaDerivacion DateTime  @default(now()) @map("fecha_derivacion")
  revisor         String?   @db.VarChar(200)
  fechaCierre     DateTime? @map("fecha_cierre")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expediente DebidaDiligencia @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@unique([expedienteId, nombreARevisar])
  @@index([expedienteId])
  @@index([estado])
  @@map("debida_diligencia_reputacion")
}

/// Estado consolidado de Debida Diligencia para la lista oficial de empresas.
/// Es independiente del expediente del portal: sirve para consulta externa y
/// control de acceso a la plataforma de reservas.
model DebidaDiligenciaEmpresaEstado {
  id               String   @id @default(uuid())
  /// RUC, DNI o identificador extranjero normalizado.
  documento        String   @unique @db.VarChar(50)
  razonSocial      String   @map("razon_social") @db.VarChar(250)
  /// RUC | DNI | EXTRANJERO | OTRO
  tipoDocumento    String   @map("tipo_documento") @db.VarChar(20)
  motivoEvaluacion String?  @map("motivo_evaluacion") @db.VarChar(250)
  eventoProyecto   String?  @map("evento_proyecto") @db.VarChar(120)
  /// Resultado normalizado: apto | apto_con_observaciones | no_apto | pendiente.
  resultado        String   @db.VarChar(30)
  /// Texto original del resultado recibido (APTO, EN REVISIÓN, etc.).
  estadoOrigen     String   @map("estado_origen") @db.VarChar(80)
  fechaIngreso     DateTime? @map("fecha_ingreso")
  fechaRevision    DateTime? @map("fecha_revision")
  fechaVencimiento DateTime? @map("fecha_vencimiento")
  origen           String   @default("excel_dd") @db.VarChar(40)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resultado])
  @@index([fechaVencimiento])
  @@index([razonSocial])
  @@map("debida_diligencia_empresa_estado")
}

/// Matriz de evaluacion de debida diligencia: una fila por VINCULO (la empresa o una
/// persona/entidad ligada a ella) de un expediente. Las filas automaticas se
/// sincronizan desde el expediente (empresa, representante, beneficiarios); las
/// manuales las agrega el usuario. Los catalogos viven en `DD_MATRIZ_*` (constants.ts).
model DdMatrizVinculo {
  id           String @id @default(uuid())
  /// Expediente DD al que pertenece el vinculo.
  expedienteId String @map("expediente_id")
  /// Tipo de vinculo (DD_MATRIZ_TIPOS_VINCULO).
  tipo         String @db.VarChar(20)
  /// Clave estable dentro del expediente: "empresa", "representante", id del beneficiario o uuid manual.
  refKey       String @map("ref_key") @db.VarChar(60)
  /// Origen de la fila (DD_MATRIZ_ORIGENES): automatico o manual.
  origen       String @default("automatico") @db.VarChar(15)

  /// Identificacion del vinculo (razon social o nombre de la persona).
  nombre        String  @db.VarChar(250)
  tipoDocumento String? @map("tipo_documento") @db.VarChar(30)
  documento     String? @db.VarChar(30)
  nacionalidad  String? @db.VarChar(80)
  cargo         String? @db.VarChar(120)
  /// Ambito efectivo (DD_MATRIZ_AMBITOS): decide que listas restrictivas aplican.
  ambito        String  @default("nacional") @db.VarChar(15)
  /// true cuando SIG corrigio el ambito a mano: la sincronizacion ya no lo recalcula.
  ambitoEditado Boolean @default(false) @map("ambito_editado")
  /// Pais del vinculo (ISO 3166-1 alpha-2); null cuando no se conoce (se muestra "?").
  pais          String? @db.VarChar(2)
  /// true cuando SIG fijo el pais a mano: la sincronizacion ya no lo recalcula.
  paisEditado   Boolean @default(false) @map("pais_editado")
  /// true cuando SIG completo/corrigio nombre, documento, nacionalidad o cargo de una fila
  /// automatica: la sincronizacion deja de pisarlos.
  identidadEditada Boolean @default(false) @map("identidad_editada")

  /// Datos generales de la empresa (solo en el vinculo de tipo empresa).
  fechaInicioActividades DateTime? @map("fecha_inicio_actividades") @db.Date
  estadoContribuyente    String?   @map("estado_contribuyente") @db.VarChar(80)
  direccionLegal         String?   @map("direccion_legal") @db.VarChar(400)
  actividadEconomica     String?   @map("actividad_economica") @db.VarChar(200)
  /// Motivo de la evaluacion (exhibidor, auspiciador, proveedor...).
  motivo                 String?   @db.VarChar(250)
  eventoProyecto         String?   @map("evento_proyecto") @db.VarChar(120)
  historialIimp          String?   @map("historial_iimp") @db.VarChar(5)
  beneficioMutuo         String?   @map("beneficio_mutuo") @db.VarChar(5)

  /// Respuesta SI/NO/N.A. de cada lista restrictiva: { codigo: "si" | "no" | "na" }.
  listas Json @default("{}")

  /// Bloque SIG (Logistica).
  sigFecha         DateTime? @map("sig_fecha")
  sigResponsable   String?   @map("sig_responsable") @db.VarChar(200)
  sigResultado     String?   @map("sig_resultado") @db.VarChar(20)
  sigObservaciones String?   @map("sig_observaciones") @db.VarChar(2000)
  sigConclusion    String?   @map("sig_conclusion") @db.VarChar(40)

  /// Bloque reputacional (Comunicaciones).
  repFecha         DateTime? @map("rep_fecha")
  repResponsable   String?   @map("rep_responsable") @db.VarChar(200)
  repResultado     String?   @map("rep_resultado") @db.VarChar(20)
  repObservaciones String?   @map("rep_observaciones") @db.VarChar(2000)
  repConclusion    String?   @map("rep_conclusion") @db.VarChar(40)

  /// Bloque Compliance (Legal).
  cmpFecha         DateTime? @map("cmp_fecha")
  cmpResponsable   String?   @map("cmp_responsable") @db.VarChar(200)
  cmpResultado     String?   @map("cmp_resultado") @db.VarChar(20)
  cmpObservaciones String?   @map("cmp_observaciones") @db.VarChar(2000)
  cmpConclusion    String?   @map("cmp_conclusion") @db.VarChar(40)

  /// Resultado final (DD_MATRIZ_RESULTADOS_FINALES); lo da SIG o Compliance.
  resultadoFinal String?   @map("resultado_final") @db.VarChar(30)
  finalFecha     DateTime? @map("final_fecha")
  finalPor       String?   @map("final_por") @db.VarChar(200)

  creadoPor      String   @map("creado_por") @db.VarChar(200)
  actualizadoPor String?  @map("actualizado_por") @db.VarChar(200)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  expediente DebidaDiligencia   @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  adjuntos   DdMatrizAdjunto[]

  @@unique([expedienteId, tipo, refKey])
  @@index([expedienteId])
  @@index([resultadoFinal])
  @@index([sigConclusion])
  @@index([expedienteId, ambito])
  @@index([pais])
  @@map("dd_matriz_vinculo")
}

/// Informe y sustento adjunto a un vinculo de la matriz (DD_MATRIZ_ADJUNTO_CATEGORIAS).
model DdMatrizAdjunto {
  id         String   @id @default(uuid())
  vinculoId  String   @map("vinculo_id")
  /// Categoria del adjunto; `sig_informe` habilita la seccion de Compliance.
  categoria  String   @db.VarChar(30)
  nombre     String   @db.VarChar(250)
  url        String   @db.VarChar(500)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  tamano     Int
  creadoPor  String   @map("creado_por") @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at")

  vinculo DdMatrizVinculo @relation(fields: [vinculoId], references: [id], onDelete: Cascade)

  @@index([vinculoId, categoria])
  @@map("dd_matriz_adjunto")
}
