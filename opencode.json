{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".opencode/reglas", ".opencode/skills"]
  },
  "model": "kimi-open/kimi-k3",
  "mcp": {
    "stitch": {
      "type": "local",
      "command": [
        "C:\\Proyectos\\IIMP\\ContratosStands\\scripts\\stitch-proxy.cmd"
      ],
      "enabled": true,
