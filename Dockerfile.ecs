# Dockerfile ECS — Next.js standalone (multi-stage) para Fargate
# Sin nginx: el ALB termina TLS y hace el health check en /api/health.
# La imagen final solo lleva lo que produce `next build` (output: standalone).

FROM node:20-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci && npm cache clean --force

FROM node:20-bookworm-slim AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# ── Variables NEXT_PUBLIC_* (se inlinean en el bundle del navegador) ─────────
# Deben existir EN EL BUILD, no solo en runtime. Valores por defecto seguros:
#   NEXT_PUBLIC_API_URL=/api   -> mismo origen (funciona en cualquier dominio)
#   NEXT_PUBLIC_API_MOCK=0     -> datos reales (nunca mocks en produccion)
ARG NEXT_PUBLIC_API_URL=/api
ARG NEXT_PUBLIC_API_MOCK=0
ARG NEXT_PUBLIC_APP_ENV=production
ARG NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_API_MOCK=$NEXT_PUBLIC_API_MOCK \
    NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL

# ── Placeholders SOLO para el build ─────────────────────────────────────────
# `next build` evalúa los route handlers ("collect page data") y varios clientes
# (kbservicios, planogess, consultas) lanzan error al importar si falta su variable.
# Estos valores son FALSOS y sirven unicamente para que el build compile:
# en runtime la app recibe los reales como variables de entorno (Secrets Manager).
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build?schema=public" \
    KBSERVICIOS_URL="https://build.invalid" \
    PLANOGESS_API_URL="https://build.invalid" \
    AUSPICIOS_API_URL="https://build.invalid" \
    SUNAT_API_TOKEN="build-placeholder" \
    JWT_SECRET="build-time-placeholder"

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate && npm run build

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl openssl \
    && rm -rf /var/lib/apt/lists/*

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

# Standalone server (next.config.ts output: "standalone")
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public

# Asset de seed para EFS: en prod el volumen EFS montado en /app/public/uploads
# tapa los archivos de la imagen, por lo que la imagen del macro se guarda aparte
# y el entrypoint la copia al volumen si aun no existe (idempotente, no bloqueante).
RUN mkdir -p /app/seed-assets \
    && cp /app/public/uploads/perumin-mapa-pabellones.jpg /app/seed-assets/ 2>/dev/null \
    || echo "seed-assets: imagen del macro no presente en el build (se omite)"

# node_modules COMPLETO: el standalone no incluye .bin/prisma ni deps del CLI
# (necesarios para `prisma migrate deploy` en el entrypoint).
# El cliente Prisma (prisma-client-js) vive en node_modules/.prisma + @prisma/client.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts

COPY docker/entrypoint-ecs.sh /usr/local/bin/entrypoint.sh
# Defensa en profundidad: NUNCA dejar archivos .env dentro de la imagen
# (los secretos se inyectan como variables de entorno desde Secrets Manager).
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && rm -f /app/.env /app/.env.* \
    && chown -R nextjs:nodejs /app

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:3000/api/health || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
