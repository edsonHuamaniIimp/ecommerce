# ============================================================
# Desarrollo local (NO se versiona)
# ============================================================

# dependencias
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js build
/.next/
/out/
/build
next-env.d.ts

# archivos subidos por usuarios (runtime data, no codigo fuente)
/public/uploads/

# prisma generated client
/prisma/generated/

# testing / coverage
/coverage

# TypeScript incremental
*.tsbuildinfo

# variables de entorno
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# misc de SO
.DS_Store
Thumbs.db

# credenciales
*.pem
*.key

# ============================================================
# Vercel
# ============================================================
.vercel

# ============================================================
# Documentacion .md — politica de versionado
# ============================================================
# SI suben al repo (documentacion NECESARIA del proyecto):
#   - README.md, AGENTS.md, CLAUDE.md
#   - docs/**/*.md (endpoints, modelo-datos, requerimientos, etc.)
#
# NO suben (borradores / notas personales / insumos raw):

# Carpetas de notas y borradores personales
/notas/
/personal/
/borradores/
/scratch/

# Sufijos para archivos personales o borradores (en cualquier carpeta)
*.local.md
*.personal.md
*.draft.md
*.wip.md

# Insumos/fuentes raw (no son documentacion final del proyecto)
conversacionequipotecnico.md
LINEAMIENTO BD.pdf
planogess.png

# Proteccion explicita: la documentacion base del proyecto NUNCA se ignora
# (los .md normales de docs/ suben por defecto; los *.draft/*.wip/*.local no)
!README.md
!AGENTS.md
!CLAUDE.md

# ============================================================
# Terraform (IaC — estado y secretos NO se versionan)
# Nota: .terraform.lock.hcl SI se versiona (recomendacion HashiCorp)
# ============================================================
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# Los perfiles de escalado SI se versionan (no contienen secretos, solo capacidades)
!terraform/perfiles/*.tfvars
# Artefactos de plan (pueden contener valores sensibles: nunca versionar)
tfplan*
plan-*.json

# ============================================================
# opencode: solo reglas/skills/agentes (el resto es cache local)
# ============================================================
# NO ignorar la carpeta completa — se trackea lo que el equipo comparte
.opencode/*
!.opencode/agent/
!.opencode/reglas/
!.opencode/skills/

# Colecciones Postman con credenciales (NO commitear: repo publico)
docs/05-integraciones/postman-sgc.json
